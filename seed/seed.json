									"cta_label": "Contact Us",
									"cta_url": "/contact"
								},
								{
									"name": "Pro",
									"price": "$29",
									"period": "/user/month",
									"description": "For growing teams",
									"features": "Unlimited team members\nUnlimited projects\nAdvanced analytics\nPriority support\n100GB storage\nCustom integrations\nAPI access",
